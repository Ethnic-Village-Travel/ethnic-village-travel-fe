name: Next Deployment

on:
  push:
    branches: [production]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy using ssh
        uses: appleboy/ssh-action@master
        with:
          host: ${{ secrets.HOST }}
          username: ${{ secrets.USERNAME }}
          password: ${{ secrets.PASSWORD }}
          port: 22
          script: |
            cd /home/ubuntu/ethnic-village-travel-fe
            git fetch origin
            git checkout dev
            git pull
            docker build -t ethnic-village-travel-fe .
            docker stop ethnic-village-travel-fe || true
            docker rm ethnic-village-travel-fe || true
            docker run -d --name ethnic-village-travel-fe -p 3000:3000 ethnic-village-travel-fe
